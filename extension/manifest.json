{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://github.com/ChiChou/sidestage",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "system.display"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_appShortName__",
    "default_icon": {
      "16": "icons/sidestage-16.png",
      "32": "icons/sidestage-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content-queue.js"
      ],
      "css": [
        "content-queue.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "next-song": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "Command+Shift+Right"
      },
      "description": "__MSG_cmdNext__"
    },
    "toggle-play": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "__MSG_cmdTogglePlay__"
    }
  },
  "icons": {
    "16": "icons/sidestage-16.png",
    "32": "icons/sidestage-32.png",
    "48": "icons/sidestage-48.png",
    "128": "icons/sidestage-128.png"
  }
}
